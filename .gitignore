# ============================================================
#  Personal Finance Spend Auditor — .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
.installed.cfg
lib/
lib64/

# Virtual environments
venv/
env/
ENV/
.venv/
.env/
backend/venv/

# Environment variables (never commit real secrets)
.env
backend/.env
frontend/.env

# Alembic
# (keep alembic/versions tracked — only exclude local artifacts)

# ----- Node / Frontend -----
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.next/
.nuxt/
.output/

# Vite cache
.vite/
frontend/.vite/

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
# (keep package-lock if using npm workspaces — remove this line if so)

# ----- Uploads (user data — never commit) -----
backend/uploads/
uploads/

# ----- OS Files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.history/
.fleet/

# ----- Testing -----
.coverage
htmlcov/
.pytest_cache/
coverage.xml
*.cover
.hypothesis/

# ----- Misc -----
*.log
*.tmp
*.temp
.cache/
