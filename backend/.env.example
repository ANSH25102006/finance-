# ============================================================
#  Personal Finance Spend Auditor — Backend .env.example
#  Copy this file to .env and fill in your real values.
#  Never commit the actual .env file.
# ============================================================

# ---- App Settings ----
DEBUG=True
APP_NAME="Personal Finance Spend Auditor"

# ---- Database ----
# PostgreSQL connection string (used in production e.g. Render / Railway / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/finance_auditor

# ---- Security ----
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- CORS Production Setting ----
# Comma-separated list of allowed frontend origins for production
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
